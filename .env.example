# Copy to .env and fill in. Never commit real secrets.
# Every variable maps 1:1 to a field in backend/app/core/config.py.

APP_ENV=local                      # local | test | production
LOG_LEVEL=INFO

# --- Auth ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-env-this-is-only-for-local-dev   # openssl rand -hex 32
JWT_TTL_MINUTES=60

# --- Shared state -------------------------------------------------------------------
# Required for horizontal scaling: rate limits, checkpoints and long-term memory.
# REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=0.2

# --- LLM ----------------------------------------------------------------------------
# LLM_PROVIDER=none runs the whole graph on deterministic fallbacks (offline demo mode).
LLM_PROVIDER=anthropic             # anthropic | openai | gemini | none
LLM_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings + vector store ------------------------------------------------------
# Offline: EMBEDDING_PROVIDER=hash + VECTOR_STORE=memory (index built at startup).
# Production: EMBEDDING_PROVIDER=pinecone + VECTOR_STORE=pinecone (run data/ingest.py first).
EMBEDDING_PROVIDER=hash            # pinecone | openai | hash
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSION=1024
VECTOR_STORE=memory                # pinecone | memory
PINECONE_API_KEY=
PINECONE_DENSE_INDEX=cb-knowledge-dense
PINECONE_SPARSE_INDEX=cb-knowledge-sparse
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Retrieval ----------------------------------------------------------------------
RETRIEVAL_FUSION=rrf               # rrf | weighted
RETRIEVAL_DENSE_WEIGHT=0.6
RETRIEVAL_SPARSE_WEIGHT=0.4
RETRIEVAL_TOP_N=6
RERANKER=lexical                   # pinecone | lexical | none

# --- Recursive research (RLM) -------------------------------------------------------
RLM_MAX_BATCHES=8
RLM_MAX_DEPTH=2
RLM_MAX_DOCS_PER_SLICE=2
RLM_BATCH_CONCURRENCY=4

# --- Memory -------------------------------------------------------------------------
CHECKPOINTER=memory                # memory | redis
LONG_TERM_MEMORY_ENABLED=true

# --- Tools --------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8765/mcp

# --- Observability (read by the LangSmith SDK directly) -----------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
